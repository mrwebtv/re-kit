# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://payload:payload@postgres:5432/realestate

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public URL, no trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

CRON_SECRET=YOUR_CRON_SECRET_HERE
PREVIEW_SECRET=YOUR_SECRET_HERE

# Leads: fallback inbox when a property has no agent
LEADS_INBOX=you@yourdomain.com

# Email (Hostinger Mail, Resend SMTP, etc). Leave SMTP_HOST empty to log emails to the console.
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=Your Agency
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
