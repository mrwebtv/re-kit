# All values are optional. Leave blank to use the defaults.
# Hostinger Docker Manager loads this file automatically, so never put placeholder values here,
# and never use an equals sign in a comment (Docker Manager reads it as a variable).

# Your domain, pointed at the VPS IP (A record). Enables a trusted HTTPS certificate.
# Leave blank and the site runs on the server IP with a self-signed certificate.
DOMAIN=

# Ports, if 80/443 are already used on the server (e.g. 8080 and 8443)
HTTP_PORT=
HTTPS_PORT=

# Database password. Leave blank for the default (the database is never exposed outside the server).
POSTGRES_PASSWORD=

# Leads: fallback inbox when a property has no agent
LEADS_INBOX=

# Email (Hostinger Mail: smtp.hostinger.com, port 465). With no SMTP_HOST, emails are logged instead.
EMAIL_FROM=
EMAIL_FROM_NAME=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Main language of the website: en, fr, es, de, it, pt, nl or ar. Leave blank for English.
# Set it before adding content. Other languages are switched on in Site Settings > Languages.
DEFAULT_LANGUAGE=
