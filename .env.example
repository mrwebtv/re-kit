# Your domain, already pointed at the VPS IP (A record). Caddy gets the SSL certificate.
DOMAIN=yourdomain.com
NEXT_PUBLIC_SERVER_URL=https://yourdomain.com

# Database password (any long random string)
POSTGRES_PASSWORD=CHANGE_ME

# Secrets: any long random strings (openssl rand -hex 32)
PAYLOAD_SECRET=CHANGE_ME
CRON_SECRET=CHANGE_ME
PREVIEW_SECRET=CHANGE_ME

# Leads: fallback inbox when a property has no agent
LEADS_INBOX=you@yourdomain.com

# Email (Hostinger Mail: smtp.hostinger.com, port 465). Leave SMTP_HOST empty to log emails instead.
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=Your Agency
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Local development only (docker-compose.dev.yml or pnpm dev)
# DATABASE_URL=postgresql://payload:payload@localhost:5432/realestate
